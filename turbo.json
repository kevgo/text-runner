{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "cache": false,
      "dependsOn": ["^build"]
    },
    "cuke": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "doc": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "fix": {
      "cache": false
    },
    "lint": {
      "cache": false
    },
    "reset": {
      "cache": false
    },
    "test": {
      "cache": false,
      "dependsOn": ["build", "unit", "cuke", "doc"]
    },
    "unit": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
